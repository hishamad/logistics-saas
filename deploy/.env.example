# Copy to deploy/.env. This file contains placeholders, never working secrets.
FREIGHT_MODE=production
PUBLIC_HOST=freight.example.com
PUBLIC_ORIGIN=https://freight.example.com
ALLOWED_HOSTS=["freight.example.com"]
FREIGHT_ALLOWED_ORIGINS=["https://freight.example.com"]
# Use URL-encoded passwords matching the two files in deploy/secrets/.
DATABASE_URL=postgresql+psycopg://freight_app:REPLACE_WITH_APP_PASSWORD@db:5432/freight
MIGRATION_DATABASE_URL=postgresql+psycopg://freight_owner:REPLACE_WITH_OWNER_PASSWORD@db:5432/freight
OIDC_ISSUER=https://identity.example.com/realms/freight
OIDC_CLIENT_ID=freight-planning
OIDC_CLIENT_SECRET=REPLACE_WITH_PROVIDER_CLIENT_SECRET
SESSION_SIGNING_KEY=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
OPENAI_API_KEY=
OPENAI_MODEL_RULES=gpt-6-luna
OPENAI_REASONING_EFFORT=low
WORKER_LEASE_SECONDS=45
